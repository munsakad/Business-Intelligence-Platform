# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for all AI generation (SQL, dashboards, reports, forecast commentary).
# gemini-3.5-flash is fast/cheap and works well for this app. Google periodically
# deprecates older model names for new API keys (e.g. gemini-2.5-flash returns a 404
# "no longer available to new users" error) -- if generation starts failing with a
# 404, run the snippet in README's "Notes & limitations" section to list models your
# key can actually use, and swap the name here.
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Where uploaded datasets (as SQLite files) are stored
DATA_DIR=./data
